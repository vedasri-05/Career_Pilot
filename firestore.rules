rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile and all user-owned subcollections (resumes, saved_jobs, roadmap, mock_interviews)
    match /users/{userId} {
      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;

      // User personal subcollections
      match /{subcollection}/{docId} {
        allow read, write:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
